.tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 24px; }
.tags span { padding: 7px 10px; border: 1px solid var(--line); color: var(--muted); font-family: var(--font-body); font-size: 13px; }
.project-action { padding-top: 19px; border-top: 1px solid var(--line); font-family: var(--font-body); font-size: 13px; }
.project-action a, .project-action span { display: inline-flex; align-items: center; gap: 11px; }
.project-action span { color: var(--muted); }
.project-action a:hover { color: var(--accent-deep); }

.tech-section { background: var(--paper-soft); }
.tech-groups { margin-top: 70px; border-top: 1px solid var(--line); }
.tech-group { display: grid; grid-template-columns: 235px 1fr; gap: 40px; padding: 40px 0; border-bottom: 1px solid var(--line); }
.tech-group-heading > span { color: var(--accent-deep); font-size: 13px; }
.tech-group-heading h3 { margin: 9px 0; font-family: var(--font-body); font-size: 18px; font-weight: 500; line-height: 1.3; }
.tech-group-heading p { color: var(--muted); font-family: var(--font-body); font-size: 13px; }
.tech-items { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
.tech-chip { position: relative; display: flex; align-items: center; gap: 12px; padding: 13px 17px; border: 1px solid var(--line); background: transparent; font-family: var(--font-body); font-size: 14px; cursor: default; transition: background .25s, border-color .25s, transform .25s; }
.tech-chip:hover, .tech-chip:focus-visible { transform: translateY(-3px); border-color: var(--accent); background: #e6f2ff; }
.tech-monogram { display: grid; place-items: center; width: 29px; height: 29px; color: var(--accent-deep); font-size: 15px; font-weight: 700; }
.chip-arrow { color: var(--muted); font-size: 12px; }
.tech-popover { position: absolute; bottom: calc(100% + 9px); left: 0; padding: 8px 10px; background: var(--dark); color: #ededed; font-size: 12px; opacity: 0; pointer-events: none; transition: opacity .2s; white-space: nowrap; }
.tech-chip:hover .tech-popover, .tech-chip:focus-visible .tech-popover { opacity: 1; }

.achievements-section { background: var(--paper); }
.achievements-list { margin-top: 65px; border-top: 1px solid var(--line); }
.achievement { display: grid; grid-template-columns: 65px 1fr auto; align-items: center; gap: 20px; padding: 27px 0; border-bottom: 1px solid var(--line); }
.achievement-icon { display: grid; place-items: center; width: 50px; height: 50px; color: var(--accent-deep); }
.achievement-main > span, .achievement-end { color: var(--accent-deep); font-family: var(--font-body); font-size: 13px; }
.achievement-main h3 { margin: 9px 0; font-family: var(--font-body); font-size: 18px; font-weight: 500; line-height: 1.3; }
