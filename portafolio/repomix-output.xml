:root {
  --paper: #ededed;
  --paper-soft: #f7f9fc;
  --paper-deep: #e2eaf2;
  --ink: #003159;
  --muted: #49657c;
  --accent: #006bff;
  --accent-deep: #005bb8;
  --dark: #003159;
  --line: #cbd9e6;
}

#root { overflow: hidden; }
main, .site-footer { margin-left: 0; }
.page-section:not(.hero-section) { position: relative; padding: 106px clamp(34px, 6vw, 105px); scroll-margin-top: 90px; }
.page-section:not(.hero-section) > * { max-width: 1200px; margin-left: auto; margin-right: auto; }
.section-index { display: flex; align-items: baseline; gap: 18px; margin-bottom: 46px; color: var(--accent-deep); }
.section-index strong { font-family: var(--font-display); font-size: clamp(38px, 4vw, 54px); font-weight: 400; line-height: 1; font-variant-ligatures: none; }
.section-index span { font-family: var(--font-body); font-size: 18px; font-weight: 500; }
.section-heading h2 { max-width: 890px; margin: 0; font-family: var(--font-display); font-size: clamp(40px, 4.5vw, 54px); font-weight: 400; line-height: 1.1; letter-spacing: -.02em; font-variant-ligatures: none; }
.section-heading h2 em { color: var(--accent-deep); font-weight: 400; }
.section-heading > p { max-width: 600px; margin: 25px 0 0; color: var(--muted); font-family: var(--font-body); font-size: 16px; line-height: 1.5; }
.skip-link { position: fixed; z-index: 1000; top: -100px; left: 20px; padding: 12px 18px; background: var(--dark); color: #ededed; }
.skip-link:focus { top: 12px; }

.about-section { border-top: 1px solid var(--line); background: var(--paper-soft); }
.about-grid { display: grid; grid-template-columns: 1fr .78fr; gap: 9%; }
.about-text { padding-top: 30px; }
.about-text p { color: var(--muted); font-family: var(--font-body); font-size: 16px; line-height: 1.5; }
.about-text .lead { margin-top: 0; color: var(--ink); font-family: var(--font-display); font-size: clamp(21px, 2vw, 27px); line-height: 1.5; letter-spacing: -.04em; font-variant-ligatures: none; }
.about-photo { position: relative; display: flex; align-items: end; justify-content: center; height: 360px; max-width: 550px; margin-top: 54px; overflow: hidden; border: 1px solid #bdd0e0; background: linear-gradient(140deg, #dbe9f5, #b9d7ef); }
.about-photo::before { position: absolute; top: 50px; left: 50%; width: 235px; height: 235px; transform: translateX(-50%); border: 1px solid #8eb7d8; border-radius: 50%; content: ""; }
.about-photo span { position: relative; margin-bottom: 25px; padding: 12px 18px; background: var(--paper-soft); color: var(--muted); font-family: var(--font-body); font-size: 13px; }

.projects-section { background: var(--paper); }
.carousel { margin-top: 38px; }
.carousel-controls { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 22px; color: var(--accent-deep); font-family: var(--font-body); font-size: 15px; }
.carousel-controls > div { display: flex; gap: 9px; }
.carousel-controls button { display: grid; place-items: center; width: 43px; height: 43px; border: 1px solid var(--accent-deep); border-radius: 50%; background: transparent; color: var(--accent-deep); font-size: 22px; line-height: 1; transition: background .2s, color .2s; }
.carousel-controls button:hover:not(:disabled) { border-color: var(--dark); background: var(--dark); color: #ededed; }
.carousel-controls button:disabled { opacity: .3; cursor: default; }
.projects-track { display: flex; gap: 22px; padding: 0 1px 24px; overflow-x: auto; outline-offset: 3px; scrollbar-width: thin; scrollbar-color: #8db6d7 transparent; scroll-snap-type: x mandatory; }
.project-card { flex: 0 0 calc((100% - 22px) / 2); min-width: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 12px; background: #fff; scroll-snap-align: start; }
.project-preview { position: relative; display: flex; align-items: center; justify-content: center; height: 265px; overflow: hidden; background: var(--preview-bg); }
.project-preview.purple { --preview-bg: #466c99; }
.project-preview.orange { --preview-bg: #317ab8; }
.project-preview.mint { --preview-bg: #6d9ac3; }
.project-preview.blue { --preview-bg: #124c7b; }
.project-preview.pink { --preview-bg: #7594b2; }
.preview-mark { transform: rotate(-12deg); color: #ffffff80; font-family: var(--font-display); font-size: 180px; font-style: italic; line-height: 1; user-select: none; }
.preview-label { position: absolute; bottom: 18px; left: 22px; color: #fff; font-family: var(--font-body); font-size: 13px; letter-spacing: -.01em; }
.project-content { padding: 28px; }
