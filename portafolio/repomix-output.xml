  font-weight: 500;
}
.section-heading h2 {
  max-width: 890px;
  margin: 0;
  font-family: var(--font-display);
  font-size: clamp(40px, 4.5vw, 54px);
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: -0.02em;
  font-variant-ligatures: none;
}
.section-heading h2 em {
  color: var(--accent-deep);
