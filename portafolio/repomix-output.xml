  gap: 18px;
  margin-bottom: 46px;
  color: var(--accent-deep);
}
.section-index strong {
  font-family: var(--font-display);
  font-size: clamp(38px, 4vw, 54px);
  font-weight: 400;
  line-height: 1;
  font-variant-ligatures: none;
}
.section-index span {
  font-family: var(--font-body);
  font-size: 18px;
  font-weight: 500;
}
.section-heading h2 {
  max-width: 890px;
  margin: 0;
  font-family: var(--font-display);
  font-size: clamp(40px, 4.5vw, 54px);
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: -0.02em;
  font-variant-ligatures: none;
}
.section-heading h2 em {
  color: var(--accent-deep);
  font-weight: 400;
}
.section-heading > p {
  max-width: 600px;
  margin: 25px 0 0;
  color: var(--muted);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.5;
}
.skip-link {
  position: fixed;
  z-index: 1000;
  top: -100px;
  left: 20px;
  padding: 12px 18px;
  background: var(--dark);
  color: #ededed;
}
.skip-link:focus {
  top: 12px;
}

.about-section {
  background: linear-gradient(180deg, #0d0b18 0%, #0d1934 55%, #0b2544 100%);
  color: #ededed;
}
.about-section .section-index {
  color: #9ccdff;
}
.about-section .section-heading h2 em {
  color: #b1c7fa;
}
.about-grid {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 8%;
  align-items: start;
}
.about-text {
  margin-top: 34px;
}
.about-text p {
  color: #cbd9e6;
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.5;
}
.about-text .lead {
  margin-top: 0;
  color: #ededed;
  font-family: var(--font-display);
  font-size: clamp(21px, 2vw, 27px);
  line-height: 1.4;
  letter-spacing: -0.02em;
  font-variant-ligatures: none;
}

.about-facts {
  margin: 38px 0 0;
  border-top: 1px solid rgba(237, 237, 237, .25);
  font-family: var(--font-mono);
  font-size: 13px;
}
.about-facts > div {
  display: grid;
  grid-template-columns: 110px 1fr;
  gap: 16px;
  padding: 13px 0;
  border-bottom: 1px solid rgba(237, 237, 237, .25);
}
.about-facts dt {
  color: #9ccdff;
}
.about-facts dt::after {
  content: " →";
  color: #8aa9c6;
}
.about-facts dd {
  margin: 0;
  color: #ededed;
}
/* Ventana de editor */
.code-window {
  overflow: hidden;
  border: 1px solid rgba(237, 237, 237, .28);
  border-radius: 12px;
  background: #061c34;
  box-shadow:
    rgba(0, 0, 0, .18) 0 8px 25px,
    rgba(0, 0, 0, .12) 0 20px 55px;
}
.window-bar {
  display: flex;
  align-items: flex-end;
  gap: 18px;
  padding: 10px 14px 0;
  border-bottom: 1px solid rgba(237, 237, 237, .2);
  background: #0c2946;
}
.window-dots {
  display: flex;
  gap: 6px;
  align-self: center;
  padding-bottom: 10px;
}
.window-dots span {
  width: 10px;
  height: 10px;
  border: 1px solid #7ba9d6;
  border-radius: 50%;
}
.window-tabs {
  display: flex;
  gap: 4px;
}
.window-tab {
  padding: 9px 14px;
  border: 1px solid transparent;
  border-bottom: 0;
  border-radius: 8px 8px 0 0;
  background: transparent;
  color: #bdd0e2;
  font-family: var(--font-mono);
  font-size: 12px;
  transition:
    color 0.2s,
    background 0.2s;
}
.window-tab:hover {
  color: #fff;
}
.window-tab.is-active {
  margin-bottom: -1px;
  border-color: rgba(237, 237, 237, .25);
  background: #103759;
  color: #ededed;
}
.window-tab.is-active[id="tab-codigo"] {
  background: #103759;
  border-color: rgba(237, 237, 237, .25);
  color: #ededed;
}

.window-body {
  height: 400px;
}
.window-body [role="tabpanel"] {
  height: 100%;
}
.window-body [hidden] {
  display: none;
}

.photo-placeholder {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 100%;
  background: linear-gradient(140deg, #dbe9f5, #b9d7ef);
}
.photo-placeholder::before {
  position: absolute;
  top: 56px;
  left: 50%;
  width: 200px;
  height: 200px;
  transform: translateX(-50%);
  border: 1px solid #8eb7d8;
  border-radius: 50%;
  content: "";
}
.photo-placeholder span {
  position: relative;
  margin-bottom: 24px;
  padding: 10px 16px;
  background: var(--paper-soft);
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: 12px;
}
.photo-panel img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.code-panel {
  overflow: auto;
  background: var(--dark);
}
.code-panel pre {
  margin: 0;
  padding: 26px 22px;
  counter-reset: line;
  font-family: var(--font-mono);
  font-size: 13px;
  line-height: 1.9;
  color: #e7f1fa;
}
.code-line {
  display: block;
  counter-increment: line;
  white-space: pre-wrap;
}
.code-line::before {
  display: inline-block;
  width: 28px;
  margin-right: 18px;
  color: #6b98bc;
  text-align: right;
  content: counter(line);
  user-select: none;
}
.code-line.indent {
  padding-left: 24px;
}
.tok-kw {
  color: #9ccdff;
}
.tok-var {
  color: #ededed;
  font-weight: 600;
}
.tok-key {
  color: #9ccdff;
}
.tok-str {
  color: #7db7ff;
}
.tok-bool {
  color: #a6edcb;
}
.projects-section {
  background: var(--paper);
}
.carousel {
  --project-gap: 18px;
  margin-top: 38px;
}
.carousel-controls {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 20px;
  margin-top: 22px;
  color: var(--accent-deep);
  font-family: var(--font-body);
  font-size: 15px;
}
.carousel-buttons {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  margin-bottom: 20px;
}
.carousel-arrow {
  display: grid;
  place-items: center;
  width: 43px;
  height: 43px;
  padding: 0;
  border: 1px solid var(--accent-deep);
  border-radius: 50%;
  background: transparent;
  color: var(--accent-deep);
  transition:
    background 0.2s,
    color 0.2s;
}
.carousel-arrow:hover:not(:disabled) {
  border-color: var(--dark);
  background: var(--dark);
  color: #ededed;
}
.carousel-arrow:disabled {
  opacity: 0.3;
  cursor: default;
}
.carousel-arrow svg,
.credits-close svg {
  display: block;
}
.carousel-dots {
  grid-column: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
}
.carousel-dot {
  width: 10px;
  height: 10px;
  padding: 0;
  border: 1px solid var(--accent-deep);
  border-radius: 20px;
  background: transparent;
  transition: width 0.2s, background 0.2s;
}
.carousel-dot.is-selected {
  width: 27px;
  background: var(--accent-deep);
}
.carousel-count {
  grid-column: 3;
  justify-self: end;
  font-family: var(--font-mono);
  font-size: 13px;
}
.projects-viewport {
  overflow: hidden;
  outline-offset: 4px;
}
.projects-track {
  display: flex;
  width: 100%;
  margin-left: calc(var(--project-gap) * -1);
  touch-action: pan-y pinch-zoom;
}
.project-slide {
  display: flex;
  flex: 0 0 calc((100% + var(--project-gap)) / 2);
  min-width: 0;
  padding-left: var(--project-gap);
}
.project-card {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: #fff;
}
.project-preview {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 265px;
  overflow: hidden;
  padding: 34px 28px 0;
  background: linear-gradient(135deg, var(--preview-bg), var(--preview-end));
}
.project-preview.verdece {
  --preview-bg: #114b38;
  --preview-end: #69a86a;
  --preview-accent: #2b7857;
}
.project-preview.chefai {
  --preview-bg: #70cbb1;
  --preview-end: #c6e88d;
  --preview-accent: #278a70;
}
.project-preview.aprende {
  --preview-bg: #ec8c3b;
  --preview-end: #f4cb70;
  --preview-accent: #b25724;
}
.project-preview.convenios {
  --preview-bg: #173a5b;
  --preview-end: #5087a6;
  --preview-accent: #185879;
}
.project-preview.portafolio {
  --preview-bg: #0d3159;
  --preview-end: #3477b4;
  --preview-accent: #1265a1;
}
.preview-browser {
  width: min(100%, 440px);
  height: 232px;
  overflow: hidden;
  border: 1px solid #ffffffa8;
  border-radius: 12px 12px 0 0;
  background: #fff;
  box-shadow: 0 18px 45px #001a3866;
  transform: rotate(-2deg) translateY(12px);
}
.preview-browser-bar {
  display: flex;
  align-items: center;
  gap: 15px;
  height: 35px;
  padding: 0 12px;
  border-bottom: 1px solid #dce6ed;
  color: #688092;
  font-family: var(--font-body);
  font-size: 10px;
  white-space: nowrap;
}
.preview-browser-dots {
  color: var(--preview-accent);
  font-size: 9px;
  letter-spacing: 2px;
}
.preview-browser-image {
  display: block;
  width: 100%;
  height: calc(100% - 35px);
  object-fit: cover;
  object-position: center top;
}
.project-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 28px;
}
.project-meta {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  color: var(--accent-deep);
  font-family: var(--font-body);
  font-size: 13px;
}
.project-meta span:last-child {
  color: var(--muted);
}
.project-content h3 {
  margin: 20px 0 10px;
  font-family: var(--font-display);
  font-size: 27px;
  font-weight: 400;
  line-height: 1.3;
  letter-spacing: -0.04em;
  font-variant-ligatures: none;
}
.project-content p {
  margin: 0 0 26px;
  color: var(--muted);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.5;
}
.project-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-top: auto;
  padding-top: 19px;
  border-top: 1px solid var(--line);
  font-family: var(--font-body);
  font-size: 13px;
}
.project-action a,
.project-action button {
  display: inline-flex;
  align-items: center;
  gap: 11px;
}
.project-action button {
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--accent-deep);
  font: inherit;
  text-decoration: underline;
  text-underline-offset: 3px;
}
.project-action a:hover,
.project-action button:hover {
  color: var(--accent-deep);
}
.projects-rights-note {
  margin-top: 14px;
  color: var(--muted);
  font-family: var(--font-body);
  font-size: 12px;
  line-height: 1.5;
}
.project-credits-dialog {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: min(540px, calc(100vw - 36px));
  max-height: min(80vh, 740px);
  margin: 0;
  padding: 0;
  overflow-y: auto;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: #fff;
  color: var(--ink);
  box-shadow: 0 25px 70px #001a3866;
}
.project-credits-dialog::backdrop {
  background: #061c34a8;
}
.project-credits-content {
  position: relative;
  padding: clamp(26px, 5vw, 38px);
  font-family: var(--font-body);
}
.credits-close {
  position: absolute;
  top: 17px;
  right: 19px;
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: #fff;
  color: var(--accent-deep);
}
.credits-close:hover {
  border-color: var(--accent-deep);
  background: #e6f2ff;
}
.credits-eyebrow {
  display: block;
  max-width: calc(100% - 30px);
  color: var(--accent-deep);
  font-size: 12px;
}
.project-credits-content h4 {
  margin: 13px 0 25px;
  font-family: var(--font-display);
  font-size: clamp(27px, 5vw, 35px);
  font-weight: 400;
  line-height: 1.2;
}
.project-credits-content h5 {
  margin: 22px 0 9px;
  font-size: 14px;
}
.project-credits-content p,
.project-credits-content li span {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.55;
}
.project-credits-content p {
  margin: 0;
}
.project-credits-content ul {
  display: grid;
  gap: 13px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.project-credits-content li {
  display: grid;
  gap: 3px;
}
.project-credits-content li a {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  width: fit-content;
  color: var(--accent-deep);
  overflow-wrap: anywhere;
}
.project-credits-content .credits-note {
  margin-top: 23px;
  padding-top: 18px;
  border-top: 1px solid var(--line);
  font-size: 13px;
}

.contact-section {
  background: linear-gradient(180deg, #0b2544 0%, #0d1934 55%, #0d0b18 100%);
  color: #fff;
}
.contact-section .section-index,
.contact-section .section-heading h2 em {
  color: #fff;
}
.contact-section .section-heading > p {
  color: #fff;
}
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8%;
}
.contact-socials {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 34px;
}
.contact-socials a {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-width: 136px;
  padding: 12px 15px;
  border: 1px solid #6b98bc;
  border-radius: 8px;
  color: #fff;
  font-family: var(--font-body);
  font-size: 14px;
  transition: border-color 0.2s, background 0.2s;
}
.contact-socials a:hover {
  border-color: #9ccdff;
  background: #ffffff14;
}
.contact-socials svg {
  flex: none;
}
.contact-form {
  display: grid;
  gap: 23px;
}
.contact-form-divider {
  height: 1px;
  background: #6b98bc;
}
.contact-method-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 4px;
  padding: 4px;
  border: 1px solid #6b98bc;
  border-radius: 10px;
  background: #ffffff0c;
}
.contact-method-switch button {
  min-width: 0;
  padding: 10px 14px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: #fff;
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 500;
  transition: background 0.2s, color 0.2s;
}
.contact-method-switch button:hover:not(.is-active) {
  background: #ffffff1a;
}
.contact-method-switch button.is-active {
  background: #fff;
  color: #0b2544;
}
.contact-method-switch button:disabled {
  cursor: wait;
}
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}
.form-row.single {
  grid-template-columns: 1fr;
}
.contact-form label {
  display: grid;
  gap: 10px;
  color: #fff;
  font-family: var(--font-body);
  font-size: 13px;
}
.contact-form label b {
  font-weight: 600;
}
.contact-form input,
.contact-form textarea {
  width: 100%;
  padding: 14px 15px;
  border: 1px solid #9cbfd9;
  border-radius: 2px;
  outline: none;
  background: #ffffff0c;
  color: #fff;
  resize: vertical;
  transition: border-color 0.2s;
}
.contact-form input:focus,
.contact-form textarea:focus {
  border-color: var(--accent);
}
.contact-form input::placeholder,
.contact-form textarea::placeholder {
  color: rgb(255 255 255 / 72%);
}
.form-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.form-footer button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 15px 20px;
  border: 1px solid var(--accent);
  border-radius: 8px;
  background: transparent;
  color: #fff;
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: 500;
  transition: background-color 0.45s ease, border-color 0.45s ease, color 0.45s ease;
}
.form-footer button:hover:not(:disabled) {
  background: var(--accent);
}
.form-footer button:disabled {
  opacity: 0.6;
  cursor: wait;
}
.form-footer button.is-success {
  border-color: #17865a;
  background: #17865a;
  color: #fff;
  opacity: 1;
  cursor: default;
}
.contact-submit-content {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  animation: contact-submit-appear 0.4s ease both;
}
.contact-submit.is-success svg path {
  stroke-dasharray: 24;
  stroke-dashoffset: 24;
  animation: contact-check-draw 0.5s ease 0.16s forwards;
}
@keyframes contact-submit-appear {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes contact-check-draw {
  to { stroke-dashoffset: 0; }
}
.form-footer > span {
  color: #fff;
  font-family: var(--font-body);
  font-size: 12px;
}
.form-notice,
.form-status {
  margin: 0;
  color: #fff;
  font-family: var(--font-body);
  font-size: 12px;
  line-height: 1.5;
}
.site-footer {
  padding: 34px clamp(34px, 6vw, 105px);
  border-top: 1px solid #2b3750;
  background: #0d0b18;
  color: #ededed;
  font-family: var(--font-body);
}
.site-footer-inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: 24px;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
}
.site-footer-copyright {
  grid-column: 1;
  grid-row: 1;
  justify-self: start;
  color: #ededed;
  font-size: 12px;
  white-space: nowrap;
}
.site-footer-identity {
  display: flex;
  flex-direction: column;
  align-items: center;
  grid-column: 2;
  grid-row: 1;
  text-align: center;
}
.site-footer-identity > span {
  font-size: 17px;
  font-weight: 500;
  line-height: 1.35;
}
.site-footer-identity small {
  margin-top: 3px;
  color: #ededed;
  font-size: 12px;
}
.site-footer-back-to-top {
  display: inline-flex;
  align-items: center;
  grid-column: 3;
  grid-row: 1;
  justify-self: end;
  gap: 11px;
  min-height: 44px;
  padding: 8px 0 8px 12px;
  color: #ededed;
  font-size: 14px;
  font-weight: 500;
  white-space: nowrap;
  transition: color 0.2s ease;
}
.site-footer-back-to-top span {
  display: inline-block;
  font-size: 19px;
  line-height: 1;
  transition: transform 0.2s ease;
}
.site-footer-back-to-top:hover,
.site-footer-back-to-top:focus-visible {
  color: #3598ff;
}
.site-footer-back-to-top:hover span,
.site-footer-back-to-top:focus-visible span {
  transform: translateY(-4px);
}
.site-footer-back-to-top:focus-visible {
  outline: 2px solid #3598ff;
  outline-offset: 4px;
  border-radius: 2px;
}

@media (max-width: 1100px) {
  .contact-grid {
    gap: 4%;
  }
}

@media (max-width: 900px) {
  .page-section:not(.hero-section) {
    padding: 95px 28px 85px;
  }
  .about-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .code-window {
    order: -1;
  }
  .contact-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }
  .about-text {
    padding-top: 0;
  }
  .about-photo {
    max-width: 100%;
  }
}

@media (max-width: 760px) {
  .site-footer {
    padding: 28px 22px 30px;
  }
  .site-footer-inner {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .site-footer-back-to-top {
    justify-self: auto;
    padding: 8px 12px;
  }
  .site-footer-copyright {
    justify-self: auto;
    text-align: center;
  }
}

@media (max-width: 700px) {
  .project-slide {
