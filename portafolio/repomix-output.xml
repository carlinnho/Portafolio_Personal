.achievement-end { white-space: nowrap; }

.contact-section { background: var(--dark); color: #ededed; }
.contact-section .section-index, .contact-section .section-heading h2 em { color: #9ccdff; }
.contact-section .section-heading > p { color: #d6e6f3; }
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8%; }
.contact-form { display: grid; gap: 23px; padding-top: 30px; border-top: 1px solid #6b98bc; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.contact-form label { display: grid; gap: 10px; color: #e7f1fa; font-family: var(--font-body); font-size: 13px; }
.contact-form input, .contact-form textarea { width: 100%; padding: 14px 15px; border: 1px solid #9cbfd9; border-radius: 2px; outline: none; background: #ffffff0c; color: #fff; resize: vertical; transition: border-color .2s; }
.contact-form input:focus, .contact-form textarea:focus { border-color: var(--accent); }
.contact-form input::placeholder, .contact-form textarea::placeholder { color: #b7cce0; }
.form-footer { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.form-footer button { display: inline-flex; align-items: center; justify-content: center; gap: 18px; padding: 15px 20px; border: 1px solid var(--accent); border-radius: 8px; background: transparent; color: #ededed; font-family: var(--font-body); font-size: 15px; font-weight: 500; transition: background .2s; }
.form-footer button:hover:not(:disabled) { background: var(--accent); }
.form-footer button:disabled { opacity: .6; cursor: wait; }
.form-footer span { color: #b7cce0; font-family: var(--font-body); font-size: 12px; }
.form-notice, .form-status { margin: 0; color: #d6e6f3; font-family: var(--font-body); font-size: 12px; line-height: 1.5; }
.form-status.error { color: #ffb8b8; }
.form-status.success { color: #a6edcb; }

.site-footer { display: flex; justify-content: space-between; gap: 20px; padding: 35px clamp(34px, 6vw, 105px); background: var(--paper-deep); color: var(--muted); font-family: var(--font-body); font-size: 12px; }
.site-footer a:hover { color: var(--accent-deep); }

@media (max-width: 1100px) {
  .tech-group { grid-template-columns: 180px 1fr; }
