.sidebar {
  position: fixed;
  z-index: 100;
  top: 22px;
  left: 50%;
  display: flex;
  align-items: center;
  gap: 21px;
  width: max-content;
  max-width: calc(100% - 40px);
  min-height: 62px;
  padding: 7px 10px 7px 13px;
  transform: translateX(-50%);
  border: 1px solid rgba(237, 237, 237, .75);
  border-radius: 50px;
  background: rgba(237, 237, 237, .72);
  box-shadow: 0 2px 16px rgba(0, 31, 58, .11);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  font-family: var(--font-body);
}

.nav-emblem {
  display: grid;
  flex: none;
  place-items: center;
  width: 38px;
  height: 38px;
  border: 1px solid #aac7e1;
  border-radius: 50%;
  color: #003159;
}

.sidebar-links {
  display: flex;
  align-items: center;
  gap: 3px;
}

.sidebar-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 0 12px;
  border-radius: 30px;
  color: #003159;
  font-size: 15px;
  font-weight: 500;
  white-space: nowrap;
  transition: background .2s, color .2s;
}

.sidebar-link svg,
.sidebar-link-number {
  display: none;
}

.sidebar-link:hover,
.sidebar-link.active {
  background: rgba(0, 49, 89, .09);
  color: #003159;
}

.sidebar-links .sidebar-link:last-child {
  margin-left: 5px;
  padding-inline: 17px;
  border: 1px solid var(--accent);
  background: transparent;
  color: #003159;
  transition: background .2s, color .2s;
}

.sidebar-links .sidebar-link:last-child:hover,
.sidebar-links .sidebar-link:last-child.active {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

.mobile-navigation {
  display: none;
}

@media (max-width: 900px) {
  .sidebar {
    display: none;
  }

  .mobile-navigation {
    position: fixed;
    z-index: 200;
    top: 14px;
    left: 14px;
    display: block;
    width: calc(100% - 28px);
    height: 64px;
    overflow: hidden;
    border: 1px solid rgba(237, 237, 237, .78);
    border-radius: 50px;
    background: rgba(237, 237, 237, .78);
    box-shadow: 0 2px 16px rgba(0, 31, 58, .12);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    font-family: var(--font-body);
    transition:
      top 1s cubic-bezier(.76, 0, .24, 1),
      left 1s cubic-bezier(.76, 0, .24, 1),
      width 1s cubic-bezier(.76, 0, .24, 1),
      height 1s cubic-bezier(.76, 0, .24, 1),
      border-radius 1s cubic-bezier(.76, 0, .24, 1),
      background-color 1s ease,
      border-color 1s ease,
      box-shadow 1s ease;
  }

  .mobile-navigation.is-open {
    top: 0;
    left: 0;
    width: 100%;
    height: 100dvh;
    overflow-y: auto;
    border-color: transparent;
    border-radius: 0;
    background: #003159;
    color: #ededed;
    box-shadow: none;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  .mobile-navigation.is-open::-webkit-scrollbar {
    display: none;
  }

  .mobile-nav-header {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 7px 10px;
    background: transparent;
    transition: background-color 1s ease;
  }

  .mobile-navigation.is-open .mobile-nav-header {
    position: sticky;
    z-index: 1;
    top: 0;
    background: #003159;
  }

  .mobile-nav-emblem {
    display: grid;
    flex: none;
    place-items: center;
    width: 37px;
    height: 37px;
    border: 1px solid #aac7e1;
    border-radius: 50%;
    color: #003159;
    transition: border-color 1s ease, color 1s ease;
  }

  .mobile-navigation.is-open .mobile-nav-emblem {
    border-color: #6b98bc;
    color: #ededed;
  }

  .mobile-current-section {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .mobile-current-section span {
    color: #345e80;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
    transition: color 1s ease;
  }

  .mobile-current-section strong {
    overflow: hidden;
    color: #003159;
    font-size: 15px;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 1s ease;
  }

  .mobile-navigation.is-open .mobile-current-section span {
    color: #9ccdff;
  }

  .mobile-navigation.is-open .mobile-current-section strong {
    color: #ededed;
  }

  .mobile-menu-toggle {
    display: grid;
    flex: none;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-left: auto;
    border: 1px solid #aac7e1;
    border-radius: 50%;
    background: transparent;
    color: #003159;
    transition: border-color 1s ease, color 1s ease;
  }

  .mobile-navigation.is-open .mobile-menu-toggle {
    border-color: #6b98bc;
    color: #ededed;
  }

  .mobile-menu-icon {
    display: grid;
    gap: 5px;
    width: 19px;
  }

  .mobile-menu-icon span {
    display: block;
    width: 19px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform .2s, opacity .2s;
  }

  .mobile-navigation.is-open .mobile-menu-icon span:first-child {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-navigation.is-open .mobile-menu-icon span:nth-child(2) {
    opacity: 0;
  }

  .mobile-navigation.is-open .mobile-menu-icon span:last-child {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-menu-links {
    display: grid;
    gap: 4px;
    padding: 36px 22px calc(32px + env(safe-area-inset-bottom));
    visibility: hidden;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition:
      opacity .3s ease,
      transform .3s ease,
      visibility 0s linear .3s;
  }

  .mobile-navigation.is-open .mobile-menu-links {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    transition-delay: .65s, .65s, .65s;
  }

  .mobile-menu-links p {
    margin: 0 0 15px;
    color: #9ccdff;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .mobile-menu-links .sidebar-link {
    justify-content: flex-start;
    gap: 16px;
    min-height: 66px;
    padding: 0 14px;
    border-bottom: 1px solid rgba(237, 237, 237, .25);
    border-radius: 0;
    color: #ededed;
    font-size: clamp(20px, 5vw, 24px);
    font-weight: 500;
  }

  .mobile-menu-links .sidebar-link svg,
  .mobile-menu-links .sidebar-link-number {
    display: block;
    flex: none;
  }

  .mobile-menu-links .sidebar-link:hover,
  .mobile-menu-links .sidebar-link.active {
    background: rgba(237, 237, 237, .1);
    color: #b9dcff;
  }

  .mobile-menu-links .sidebar-link-number {
    margin-left: auto;
    color: #9ccdff;
    font-size: 12px;
  }
}
