        glow={0.5}
        fade={0.2}
        opacity={0.7}
        intro={!reducedMotion}
        mouseInteraction={!reducedMotion}
        clickShock={!reducedMotion}
        paused={Boolean(reducedMotion)}
      />
      <SectionLabel number="03">Tecnologías</SectionLabel>
